[user]
	name = Yohnathan Aldana
	email = user@localhost
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[core]
	autocrlf = input
	excludesfile = /Users/yohn/.gitignore_global
	editor = nvim
	pager = delta
[init]
	defaultBranch = main
[interactive]
    diffFilter = delta --color-only
[delta]
  navigate = true  # use n and N to move between diff sections
  dark = true      # or light = true, or omit for auto-detection
  side-by-side = true
[merge]
    conflictStyle = zdiff3
[commit]
	template = /Users/yohn/.stCommitMsg
[alias]
  st = status
  br = branch
  aa = add -A
	cm = commit -m
  lg = log
	a = add
	ap = add -p
